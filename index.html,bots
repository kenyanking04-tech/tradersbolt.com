
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TradeFlow · Realistic Trading UI + Bots</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }
        body {
            background-color: #0b0e14;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 16px;
            color: #e9edf2;
        }
        .terminal {
            max-width: 1440px;
            width: 100%;
            background-color: #131a24;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.03);
            padding: 20px 24px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        /* header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 8px;
            border-bottom: 1px solid #1e293b;
        }
        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .logo-icon {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 700;
            color: white;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }
        .logo-text {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, #f0f9ff, #b6c8e0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .badge {
            background-color: #1e2a3a;
            padding: 6px 12px;
            border-radius: 40px;
            font-size: 13px;
            font-weight: 500;
            color: #9aa8bc;
            border: 1px solid #2d3b4f;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .badge i {
            color: #22c55e;
            font-size: 10px;
        }
        .header-right {
            display: flex;
            gap: 12px;
            align-items: center;
        }
        .icon-btn {
            background-color: #1e2a3a;
            border: none;
            color: #9aa8bc;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            border: 1px solid #2d3b4f;
        }
        .icon-btn:hover {
            background-color: #2a3a4e;
            color: #f1f5f9;
        }
        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: #1e2a3a;
            padding: 6px 14px 6px 6px;
            border-radius: 40px;
            border: 1px solid #2d3b4f;
        }
        .avatar {
            background: linear-gradient(145deg, #2563eb, #7c3aed);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
            color: white;
        }
        .user-name {
            font-size: 14px;
            font-weight: 500;
            color: #e2e8f0;
        }
        /* main grid */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 20px;
        }
        /* chart card */
        .chart-card {
            background-color: #0f151e;
            border-radius: 20px;
            padding: 16px 18px 12px 18px;
            border: 1px solid #1e293b;
            box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.6);
        }
        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }
        .pair-info {
            display: flex;
            align-items: baseline;
            gap: 10px;
        }
        .pair-name {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .pair-price {
            font-size: 22px;
            font-weight: 600;
            color: #f1f5f9;
            background: #1e2a3a;
            padding: 2px 12px;
            border-radius: 30px;
            border: 1px solid #2d3b4f;
        }
        .price-change {
            font-size: 14px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 30px;
        }
        .positive {
            background-color: rgba(34, 197, 94, 0.12);
            color: #4ade80;
        }
        .negative {
            background-color: rgba(239, 68, 68, 0.12);
            color: #f87171;
        }
        .timeframe {
            display: flex;
            gap: 6px;
            background: #1a2330;
            padding: 4px;
            border-radius: 40px;
            border: 1px solid #263244;
        }
        .tf-btn {
            background: transparent;
            border: none;
            color: #8d9db5;
            font-weight: 500;
            font-size: 12px;
            padding: 6px 12px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.15s;
        }
        .tf-btn.active {
            background-color: #2d3b4f;
            color: white;
            font-weight: 600;
        }
        .tf-btn:hover {
            color: white;
        }
        .chart-container {
            position: relative;
            height: 240px;
            width: 100%;
            margin: 8px 0 8px 0;
        }
        .stats-row {
            display: flex;
            justify-content: space-between;
            border-top: 1px solid #1e293b;
            padding-top: 16px;
            margin-top: 6px;
            gap: 12px;
        }
        .stat-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .stat-label {
            font-size: 12px;
            font-weight: 500;
            color: #6f7e94;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .stat-value {
            font-size: 16px;
            font-weight: 600;
            color: #dce5f0;
        }
        /* right column */
        .right-col {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        /* watchlist */
        .watchlist-card {
            background-color: #0f151e;
            border-radius: 20px;
            padding: 16px 16px 8px 16px;
            border: 1px solid #1e293b;
        }
        .card-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .card-title h3 {
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.3px;
            color: #b9c7dd;
        }
        .card-title i {
            color: #6f7e94;
            font-size: 14px;
            cursor: pointer;
        }
        .watchlist-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #1a2330;
            cursor: pointer;
            transition: background 0.1s;
        }
        .watchlist-item:last-child {
            border-bottom: none;
        }
        .watchlist-item:hover {
            background-color: #1a2330;
            border-radius: 10px;
            padding-left: 8px;
            padding-right: 8px;
            margin-left: -8px;
            margin-right: -8px;
        }
        .coin-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .coin-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            color: white;
        }
        .btc { background: linear-gradient(145deg, #f7931a, #c76b0c); }
        .eth { background: linear-gradient(145deg, #627eea, #3b4e9c); }
        .sol { background: linear-gradient(145deg, #14f195, #0b9e63); }
        .link { background: linear-gradient(145deg, #2c67f2, #1a3f9e); }
        .coin-name {
            font-weight: 600;
            font-size: 14px;
        }
        .coin-symbol {
            font-size: 12px;
            color: #7e8ea8;
            font-weight: 400;
            margin-left: 4px;
        }
        .coin-price {
            font-weight: 600;
            font-size: 14px;
        }
        .coin-change {
            font-size: 12px;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 30px;
            min-width: 58px;
            text-align: center;
        }
        .green-bg {
            background-color: rgba(34, 197, 94, 0.12);
            color: #4ade80;
        }
        .red-bg {
            background-color: rgba(239, 68, 68, 0.12);
            color: #f87171;
        }
        /* trade panel */
        .trade-card {
            background-color: #0f151e;
            border-radius: 20px;
            padding: 18px 16px;
            border: 1px solid #1e293b;
            flex: 1;
        }
        .trade-tabs {
            display: flex;
            gap: 6px;
            background: #1a2330;
            padding: 4px;
            border-radius: 40px;
            margin-bottom: 20px;
        }
        .trade-tab {
            flex: 1;
            background: transparent;
            border: none;
            color: #8d9db5;
            font-weight: 600;
            font-size: 13px;
            padding: 8px 0;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.15s;
        }
        .trade-tab.active {
            background-color: #2d3b4f;
            color: white;
        }
        .trade-tab.buy.active {
            background-color: #1e3a2e;
            color: #4ade80;
        }
        .trade-tab.sell.active {
            background-color: #3b1e1e;
            color: #f87171;
        }
        .input-group {
            margin-bottom: 18px;
        }
        .input-label {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #7e8ea8;
            margin-bottom: 6px;
        }
        .input-label span:last-child {
            color: #b9c7dd;
        }
        .trade-input {
            background-color: #1a2330;
            border: 1px solid #263244;
            border-radius: 12px;
            padding: 12px 14px;
            width: 100%;
            font-size: 16px;
            font-weight: 500;
            color: #f1f5f9;
            outline: none;
            transition: border 0.15s;
        }
        .trade-input:focus {
            border-color: #3b82f6;
        }
        .quick-amounts {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }
        .quick-amount {
            background-color: #1a2330;
            border: 1px solid #263244;
            border-radius: 30px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 500;
            color: #b9c7dd;
            cursor: pointer;
            flex: 1;
            text-align: center;
            transition: all 0.1s;
        }
        .quick-amount:hover {
            background-color: #2d3b4f;
            color: white;
        }
        .action-btn {
            width: 100%;
            padding: 14px;
            border-radius: 14px;
            border: none;
            font-weight: 700;
            font-size: 15px;
            cursor: pointer;
            margin-top: 8px;
            transition: all 0.15s;
            letter-spacing: 0.2px;
        }
        .action-btn.buy {
            background: linear-gradient(145deg, #22c55e, #16a34a);
            color: #0b0e14;
            box-shadow: 0 8px 18px -6px rgba(34, 197, 94, 0.3);
        }
        .action-btn.buy:hover {
            background: linear-gradient(145deg, #2dd4bf, #22c55e);
        }
        .action-btn.sell {
            background: linear-gradient(145deg, #ef4444, #dc2626);
            color: white;
            box-shadow: 0 8px 18px -6px rgba(239, 68, 68, 0.3);
        }
        .action-btn.sell:hover {
            background: linear-gradient(145deg, #f87171, #ef4444);
        }
        .balance-info {
            display: flex;
            justify-content: space-between;
            margin-top: 16px;
            font-size: 12px;
            color: #7e8ea8;
            border-top: 1px solid #1e293b;
            padding-top: 16px;
        }
        .balance-info span:last-child {
            color: #e2e8f0;
            font-weight: 600;
        }
        /* BOTS PANEL */
        .bots-card {
            background-color: #0f151e;
            border-radius: 20px;
            padding: 16px;
            border: 1px solid #1e293b;
        }
        .bot-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #1a2330;
        }
        .bot-item:last-child {
            border-bottom: none;
        }
        .bot-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .bot-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #1e2a3a;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #3b82f6;
            font-size: 16px;
            border: 1px solid #2d3b4f;
        }
        .bot-name {
            font-weight: 600;
            font-size: 14px;
        }
        .bot-strategy {
            font-size: 11px;
            color: #7e8ea8;
            margin-top: 2px;
        }
        .bot-status {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .bot-pnl {
            font-weight: 600;
            font-size: 13px;
            padding: 4px 10px;
            border-radius: 30px;
        }
        .bot-pnl.positive {
            background: rgba(34, 197, 94, 0.12);
            color: #4ade80;
        }
        .bot-pnl.negative {
            background: rgba(239, 68, 68, 0.12);
            color: #f87171;
        }
        .bot-toggle {
            background: #1e2a3a;
            border: 1px solid #2d3b4f;
            color: #9aa8bc;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            transition: 0.2s;
        }
        .bot-toggle:hover {
            background: #2d3b4f;
            color: white;
        }
        .bot-toggle.active {
            background: #1e3a2e;
            color: #4ade80;
            border-color: #22c55e;
        }
        .bot-toggle.inactive {
            color: #6f7e94;
        }
        /* toast */
        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #1e2a3a;
            border: 1px solid #2d3b4f;
            padding: 14px 22px;
            border-radius: 16px;
            color: #f1f5f9;
            font-weight: 500;
            font-size: 14px;
            box-shadow: 0 20px 35px -10px black;
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(12px);
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
            pointer-events: none;
            z-index: 999;
        }
        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }
        .toast i {
            color: #22c55e;
        }
        /* responsive */
        @media (max-width: 900px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            .terminal {
                padding: 16px;
            }
            .header {
                flex-wrap: wrap;
                gap: 12px;
            }
            .stats-row {
                flex-wrap: wrap;
                gap: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="terminal">
        <!-- header -->
        <div class="header">
            <div class="logo-area">
                <div class="logo-icon">T</div>
                <div class="logo-text">TradeFlow</div>
                <div class="badge">
                    <i class="fas fa-circle"></i> Live · Bots active
                </div>
            </div>
            <div class="header-right">
                <button class="icon-btn" id="refreshBtn"><i class="fas fa-rotate-right"></i></button>
                <button class="icon-btn"><i class="fas fa-bell"></i></button>
                <div class="user-profile">
                    <div class="avatar">JD</div>
                    <span class="user-name">James D.</span>
                </div>
            </div>
        </div>

        <!-- main grid -->
        <div class="main-grid">
            <!-- chart + pair card -->
            <div class="chart-card">
                <div class="chart-header">
                    <div class="pair-info">
                        <span class="pair-name">BTC/USDT</span>
                        <span class="pair-price" id="pairPrice">$67,842.50</span>
                        <span class="price-change positive" id="priceChange">+2.34%</span>
                    </div>
                    <div class="timeframe">
                        <button class="tf-btn">1H</button>
                        <button class="tf-btn active">4H</button>
                        <button class="tf-btn">1D</button>
                        <button class="tf-btn">1W</button>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="priceChart"></canvas>
                </div>

                <div class="stats-row">
                    <div class="stat-item">
                        <span class="stat-label">24h High</span>
                        <span class="stat-value">$68,240</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">24h Low</span>
                        <span class="stat-value">$65,920</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Volume</span>
                        <span class="stat-value">1.24B</span>
      
